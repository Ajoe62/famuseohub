# Copy to .env.local for local overrides. Never commit real secrets.
# In production the server refuses to start if a required value is missing.

# --- Required in production -------------------------------------------------

# Postgres connection string. Leave unset in development to use the embedded
# PGlite database stored in .data/pglite (no database server needed).
# DATABASE_URL=postgres://user:password@host:5432/famuseohub

# Direct (non-pooled) URL used for migrations and db:* scripts. On Neon, `neon env pull` writes both:
# DATABASE_URL is the pooled (-pooler) one for the app, DATABASE_URL_UNPOOLED the direct one.
# DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/famuseohub

# Public https URL of the app (what Canvas calls). Used for LTI redirect URIs and /api/lti/config.
# Setting an https APP_URL in development also switches on iframe-safe cookies, for testing through a tunnel.
# APP_URL=https://capstone-hub.example.edu

# Signs session cookies. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# The tool's RSA private key (PKCS#8 PEM, "\n" escapes allowed). Generate with: npm run lti:keys
# In development a key is generated automatically in .data/lti-tool-key.pem.
# LTI_PRIVATE_KEY=
# LTI_KEY_ID=

# --- Optional ----------------------------------------------------------------

# Where PGlite stores data when DATABASE_URL is unset.
# PGLITE_DIR=.data/pglite

# The /dev/login page (pick a seeded user) is on in development and off in production.
# Only enable it for a demo deployment that contains no real student data.
# ENABLE_DEV_LOGIN=true

# Origins allowed to embed the app in an iframe (Canvas). Default: 'self' https://*.instructure.com
# FRAME_ANCESTORS='self' https://famu.instructure.com https://famu.beta.instructure.com https://famu.test.instructure.com
